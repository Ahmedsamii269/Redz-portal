{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role and hierarchy information in Redz agency",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "username": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["ceo", "account_manager", "unit_manager", "leader", "recruiter"] },
        "leaderId": { "type": "string", "maxLength": 128 },
        "leaderName": { "type": "string", "maxLength": 128 },
        "unitManagerId": { "type": "string", "maxLength": 128 },
        "unitManagerName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "instaPay": { "type": "string", "maxLength": 128 },
        "mobileWallet": { "type": "string", "maxLength": 64 },
        "facebook": { "type": "string", "maxLength": 512 },
        "linkedin": { "type": "string", "maxLength": 512 },
        "photoUrl": { "type": "string", "maxLength": 1024 },
        "disabled": { "type": "boolean" },
        "temporaryPassword": { "type": "string", "maxLength": 128 },
        "lastLoginAt": { "type": "string", "maxLength": 64 },
        "lastLoginIp": { "type": "string", "maxLength": 64 },
        "lastLoginDevice": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Recruitment applicant submitted by recruiter with status tracking and commission data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "phone2": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "graduateStatus": { "type": "string", "enum": ["Graduate", "Not graduate", "Student"] },
        "idNumber": { "type": "string", "maxLength": 64 },
        "hasExperience": { "type": "boolean" },
        "experienceDuration": { "type": "string", "maxLength": 128 },
        "experienceTypes": { "type": "array" },
        "area": { "type": "string", "maxLength": 256 },
        "company": { "type": "string", "maxLength": 128 },
        "offerId": { "type": "string", "maxLength": 128 },
        "language": { "type": "string", "maxLength": 64 },
        "vocarooUrl": { "type": "string", "maxLength": 512 },
        "vocarooUrl2": { "type": "string", "maxLength": 512 },
        "vocarooLanguage2": { "type": "string", "maxLength": 64 },
        "interviewDate": { "type": "string", "maxLength": 64 },
        "interviewTime": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 128 },
        "leaderId": { "type": "string", "maxLength": 128 },
        "leaderName": { "type": "string", "maxLength": 128 },
        "unitManagerId": { "type": "string", "maxLength": 128 },
        "unitManagerName": { "type": "string", "maxLength": 128 },
        "trainingStartDate": { "type": "string", "maxLength": 64 },
        "archived": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "deletedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["fullName", "phone", "company", "vocarooUrl", "status", "createdBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System action log for security and auditing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 64 },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 4096 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "action", "entityType", "timestamp"]
    },
    "JobOffer": {
      "title": "JobOffer",
      "description": "Job offer vacancy template for social media posting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "language": { "type": "string", "maxLength": 64 },
        "company": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 256 },
        "offerText": { "type": "string", "maxLength": 8192 },
        "copyText": { "type": "string", "maxLength": 8192 },
        "confirmationMessage": { "type": "string", "maxLength": 8192 },
        "interviewMaterial": { "type": "string", "maxLength": 16384 },
        "candidateAutoReply": { "type": "string", "maxLength": 2048 },
        "interviewDays": { "type": "string", "maxLength": 512 },
        "active": { "type": "boolean" }
      },
      "required": ["language", "company", "offerText"]
    },
    "Process": {
      "title": "Process",
      "description": "Company interview and hiring process guide",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 128 },
        "processSteps": { "type": "array" },
        "extraNotes": { "type": "array" }
      },
      "required": ["company"]
    },
    "CommissionRule": {
      "title": "CommissionRule",
      "description": "Commission rate card rules and cascade payout calculations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "track": { "type": "string", "maxLength": 64 },
        "companiesOrAccounts": { "type": "array" },
        "termsDays": { "type": "number" },
        "externalAmount": { "type": "number" },
        "recruiter": { "type": "number" },
        "leader": { "type": "number" },
        "unit": { "type": "number" },
        "ceoShownInSheet": { "type": "number" }
      },
      "required": ["track", "termsDays", "externalAmount", "recruiter", "leader", "unit"]
    },
    "ConfirmationTemplate": {
      "title": "ConfirmationTemplate",
      "description": "WhatsApp confirmation message template for scheduled interviews",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 128 },
        "variant": { "type": "string", "maxLength": 64 },
        "text": { "type": "string", "maxLength": 8192 },
        "usesPlaceholders": { "type": "boolean" }
      },
      "required": ["company", "text"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification and announcement record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "message": { "type": "string", "maxLength": 2048 },
        "type": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "message", "type"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Agency-wide configuration settings and branding",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "globalBroadcast": { "type": "object" },
        "customStatuses": { "type": "array" }
      }
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time user heartbeat and active page tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userRole": { "type": "string", "enum": ["ceo", "account_manager", "unit_manager", "leader", "recruiter"] },
        "lastActive": { "type": "string", "maxLength": 64 },
        "activeTab": { "type": "string", "maxLength": 64 },
        "isOnline": { "type": "boolean" },
        "photoUrl": { "type": "string", "maxLength": 1024 }
      },
      "required": ["userId", "userName", "userEmail", "userRole", "lastActive", "isOnline"]
    },
    "UsernameDirectoryEntry": {
      "title": "UsernameDirectoryEntry",
      "description": "Privacy-safe username to email lookup entry for username-based sign-in",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["username", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles, roles, and hierarchy"
    },
    "/usernameDirectory/{usernameKey}": {
      "schema": "UsernameDirectoryEntry",
      "description": "Stores lowercase username -> email mappings for sign-in resolution"
    },
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Stores candidate submissions, stages, and status history"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Stores system audit trail"
    },
    "/offers/{offerId}": {
      "schema": "JobOffer",
      "description": "Stores agency job offers"
    },
    "/processes/{processId}": {
      "schema": "Process",
      "description": "Stores recruitment and interview processes per company"
    },
    "/commissionRules/{ruleId}": {
      "schema": "CommissionRule",
      "description": "Stores commission rules for financial cascade calculations"
    },
    "/confirmationTemplates/{templateId}": {
      "schema": "ConfirmationTemplate",
      "description": "Stores WhatsApp confirmation templates"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Stores user notifications and announcements"
    },
    "/settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Stores system configuration and brand data"
    },
    "/presence/{presenceId}": {
      "schema": "UserPresence",
      "description": "Stores real-time online presence and heartbeat"
    }
  }
}
